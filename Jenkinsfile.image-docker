pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk   'JDK17'
    }

    parameters {
        string(name: 'GIT_COMMIT',
               defaultValue: '',
               description: 'Commit que originou a build de testes')
        booleanParam(name: 'QUALITY_GATE_PASSED',
                     defaultValue: false,
                     description: 'Setado pelo pipeline de testes quando Jacoco >= 99%')
    }

    stages {

        stage('Validate Quality Gate') {
            steps {
                echo 'Validating Quality Gate before building Docker image...'
                script {
                    echo """
=========================================
DOCKER IMAGE BUILD - QUALITY GATE CHECK
=========================================
QUALITY_GATE_PASSED = ${params.QUALITY_GATE_PASSED}
=========================================
"""
                    if (!params.QUALITY_GATE_PASSED) {
                        error '❌ Cannot build Docker image: Quality Gate not met in test pipeline.'
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Application') {
            steps {
                echo 'Building Spring Boot jar (tests já rodaram no pipeline-test-dev)...'
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    if command -v docker >/dev/null 2>&1; then
                      echo "Building Docker image subscription-service:latest..."
                      docker build -t subscription-service:latest .
                    else
                      echo "Docker CLI not found. Simulating docker build (no image actually created)."
                    fi
                '''
            }
        }

        stage('Test Docker Image') {
            steps {
                sh '''
                    if command -v docker >/dev/null 2>&1; then
                      echo "Running container for basic health check..."
                      docker run --rm -d --name subscription-service-test -p 8080:8080 subscription-service:latest
                      sleep 15
                      curl -f http://localhost:8080/actuator/health || (echo "Health check failed" && exit 1)
                      docker stop subscription-service-test || true
                    else
                      echo "Docker CLI not found. Skipping real container test."
                    fi
                '''
            }
        }

        stage('Push to Registry') {
            when {
                expression { return false } // Deixa desativado por enquanto (atividade acadêmica)
            }
            steps {
                echo 'Aqui entraria o push para um registry (Docker Hub, etc).'
            }
        }

        stage('Generate Image Report') {
            steps {
                echo 'Relatório da imagem: consulte os logs desta build e o docker history (quando disponível).'
            }
        }
    }

    post {
        always {
            echo 'Cleaning up Docker resources...'
            sh '''
                if command -v docker >/dev/null 2>&1; then
                  docker rmi subscription-service:latest || true
                  docker system prune -f || true
                else
                  echo "Docker CLI not found. Nothing to clean."
                fi
            '''
        }
        success {
            echo '✅ Docker image pipeline SUCCESS!'
        }
        failure {
            echo '❌ Docker image build failed!'
        }
    }
}
