pipeline {
    agent any

    environment {
        COMPOSE_FILE = 'docker-compose.staging.yml'
        APP_URL      = 'http://localhost:8081'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '========================================'
                echo 'STAGING PIPELINE'
                echo '========================================'
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Stop Existing Containers') {
            steps {
                echo 'Stopping existing containers...'
                sh '''
                    if command -v docker-compose >/dev/null 2>&1; then
                      docker-compose -f "$COMPOSE_FILE" down -v || true
                      docker system prune -f || true
                    else
                      echo "docker-compose not found. Skipping stop step (simulation only)."
                    fi
                '''
            }
        }

        stage('Start Container') {
            steps {
                echo 'Starting container from Docker image...'
                sh '''
                    if command -v docker-compose >/dev/null 2>&1; then
                      echo "Pulling latest images..."
                      docker-compose -f "$COMPOSE_FILE" pull || true
                      echo "Starting services..."
                      docker-compose -f "$COMPOSE_FILE" up -d --build --no-color
                    else
                      echo "docker-compose not found. Simulating deploy without actually starting containers."
                    fi
                '''
            }
        }

        stage('Wait for Application') {
            steps {
                sh '''
                    if command -v docker-compose >/dev/null 2>&1 && command -v curl >/dev/null 2>&1; then
                      echo "Waiting for application to be healthy..."
                      for i in $(seq 1 30); do
                        if curl -fs "$APP_URL/actuator/health" >/dev/null 2>&1; then
                          echo "Application is UP."
                          exit 0
                        fi
                        echo "Waiting... ($i/30)"
                        sleep 2
                      done
                      echo "Application did not start in expected time."
                      exit 1
                    else
                      echo "docker-compose or curl not found. Skipping real wait-for-app step."
                    fi
                '''
            }
        }

        stage('Smoke Tests') {
            steps {
                sh '''
                    if command -v curl >/dev/null 2>&1; then
                      echo "Running simple smoke test..."
                      curl -f "$APP_URL/actuator/health" || (echo "Smoke test failed" && exit 1)
                    else
                      echo "curl not found. Skipping smoke tests (simulation)."
                    fi
                '''
            }
        }

        stage('Staging Verification') {
            steps {
                echo 'Staging deployment stage finished. Check container logs if needed.'
            }
        }
    }

    post {
        always {
            echo '========================================'
            echo 'STAGING PIPELINE COMPLETED'
            echo '========================================'
            sh '''
                if command -v docker-compose >/dev/null 2>&1; then
                  echo "Final container status:"
                  docker-compose -f "$COMPOSE_FILE" ps || true
                else
                  echo "docker-compose not found. No status to show."
                fi
            '''
        }
        failure {
            echo '❌ Staging deployment failed!'
            sh '''
                if command -v docker-compose >/dev/null 2>&1; then
                  echo "Error logs:"
                  docker-compose -f "$COMPOSE_FILE" logs --tail=50 || true
                else
                  echo "docker-compose not found. Cannot show container logs."
                fi
            '''
        }
        success {
            echo '✅ Staging deployment SUCCESS!'
        }
    }
}
