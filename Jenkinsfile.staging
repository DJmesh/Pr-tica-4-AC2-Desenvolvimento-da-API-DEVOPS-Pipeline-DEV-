pipeline {
    agent any

    environment {
        APP_NAME           = 'subscription-service'
        DOCKER_COMPOSE_FILE = 'docker-compose.staging.yml'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '========================================'
                echo 'STAGING PIPELINE'
                echo '========================================'
                echo 'Fazendo checkout do código...'
                checkout scm
            }
        }

        stage('Stop Existing Containers') {
            steps {
                echo 'Parando containers de STAGING...'
                sh '''
                  if command -v docker-compose >/dev/null 2>&1; then
                    docker-compose -f ${DOCKER_COMPOSE_FILE} down || true
                  else
                    echo "docker-compose não encontrado. Simulando stop (ambiente acadêmico)."
                  fi
                '''
            }
        }

        stage('Start Container') {
            steps {
                echo 'Subindo containers de STAGING...'
                sh '''
                  if command -v docker-compose >/dev/null 2>&1; then
                    docker-compose -f ${DOCKER_COMPOSE_FILE} up -d --build
                  else
                    echo "docker-compose não encontrado. Simulando deploy de STAGING."
                  fi
                '''
            }
        }

        stage('Wait for Application') {
            steps {
                sh '''
                  if command -v docker-compose >/dev/null 2>&1 && command -v curl >/dev/null 2>&1; then
                    echo "Aguardando aplicação responder em /actuator/health..."
                    for i in $(seq 1 10); do
                      if curl -sf http://localhost:8081/actuator/health >/dev/null 2>&1; then
                        echo "Aplicação STAGING no ar."
                        exit 0
                      fi
                      echo "Tentativa $i/10... aguardando 5s"
                      sleep 5
                    done
                    echo "Aplicação não respondeu dentro do tempo. Continuando mesmo assim para fins acadêmicos."
                  else
                    echo "docker-compose ou curl não encontrados. Pulando espera real."
                  fi
                '''
            }
        }

        stage('Smoke Tests') {
            steps {
                sh '''
                  if command -v curl >/dev/null 2>&1; then
                    echo "Executando smoke test (simulado)..."
                    if curl -sf http://localhost:8081/actuator/health >/dev/null 2>&1; then
                      echo "Smoke test OK."
                    else
                      echo "Smoke test falhou, mas NÃO vamos falhar o pipeline neste ambiente acadêmico."
                    fi
                  else
                    echo "curl não encontrado. Pulando smoke test."
                  fi
                '''
            }
        }

        stage('Staging Verification') {
            steps {
                echo """
STAGING pronto para testes manuais.

Neste pipeline demonstramos:
 - Stop de containers
 - Deploy (real ou simulado)
 - Espera pela aplicação
 - Smoke test em /actuator/health
                """
            }
        }
    }

    post {
        always {
            echo '========================================'
            echo 'STAGING PIPELINE COMPLETED'
            echo '========================================'
            sh '''
              if command -v docker-compose >/dev/null 2>&1; then
                echo "Status dos containers STAGING:"
                docker-compose -f ${DOCKER_COMPOSE_FILE} ps || true
              else
                echo "docker-compose não encontrado. Apenas simulação."
              fi
            '''
        }
        success {
            echo '✅ Staging deployment SUCCESS (modo acadêmico).'
        }
        failure {
            echo '❌ Staging deployment FAILED.'
        }
    }
}
