pipeline {
    agent any

    environment {
        APP_NAME            = 'subscription-service'
        DOCKER_COMPOSE_FILE = 'docker-compose.prod.yml'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '========================================'
                echo 'PROD PIPELINE'
                echo '========================================'
                echo 'Fazendo checkout do código...'
                checkout scm
            }
        }

        stage('Stop Existing PROD Containers') {
            steps {
                echo 'Parando containers de PRODUÇÃO...'
                sh '''
                  if command -v docker-compose >/dev/null 2>&1; then
                    docker-compose -f ${DOCKER_COMPOSE_FILE} down || true
                  else
                    echo "docker-compose não encontrado. Simulando stop de PRODUÇÃO."
                  fi
                '''
            }
        }

        stage('Deploy to PROD') {
            steps {
                echo 'Realizando deploy em PRODUÇÃO...'
                sh '''
                  if command -v docker-compose >/dev/null 2>&1; then
                    docker-compose -f ${DOCKER_COMPOSE_FILE} up -d --build
                  else
                    echo "docker-compose não encontrado. Simulando deploy de PRODUÇÃO (ambiente acadêmico)."
                  fi
                '''
            }
        }

        stage('Post-Deploy Check (Simulado)') {
            steps {
                sh '''
                  if command -v curl >/dev/null 2>&1; then
                    echo "Verificando /actuator/health em PRODUÇÃO (simulado)..."
                    if curl -sf http://localhost:8081/actuator/health >/dev/null 2>&1; then
                      echo "Aplicação PROD respondeu OK."
                    else
                      echo "Aplicação PROD não respondeu, mas não iremos falhar o pipeline neste ambiente acadêmico."
                    fi
                  else
                    echo "curl não encontrado. Pulando verificação real."
                  fi
                '''
            }
        }
    }

    post {
        always {
            echo '========================================'
            echo 'PROD PIPELINE COMPLETED'
            echo '========================================'
        }
        success {
            echo '✅ Deploy em PRODUÇÃO finalizado com sucesso (modo acadêmico).'
        }
        failure {
            echo '❌ Deploy em PRODUÇÃO falhou.'
        }
    }
}
