pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JDK17'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Pre-Build') {
            steps {
                echo 'Pre-Build: Cleaning workspace and preparing environment...'
                sh '''
                    echo "Maven Version:"
                    mvn --version
                    echo "Java Version:"
                    java -version
                    mvn clean
                '''
            }
        }

        stage('Build') {
            steps {
                echo 'Build: Compiling source code...'
                sh 'mvn compile -DskipTests'
            }
        }

        stage('Test') {
            steps {
                echo 'Running all tests (JUnit)...'
                sh 'mvn test'
            }
            post {
                always {
                    echo 'Publishing test results...'
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Code Quality Analysis') {
            parallel {
                stage('JaCoCo Coverage') {
                    steps {
                        echo 'Generating JaCoCo code coverage report...'
                        sh 'mvn verify'
                    }
                    post {
                        always {
                            echo 'Publishing JaCoCo coverage report...'
                            // Archive coverage report
                            archiveArtifacts artifacts: 'target/site/jacoco/**/*', allowEmptyArchive: true
                            echo 'JaCoCo report available at: target/site/jacoco/index.html'
                        }
                    }
                }

                stage('PMD Analysis') {
                    steps {
                        echo 'Running PMD static code analysis...'
                        sh 'mvn pmd:pmd pmd:check || true'
                    }
                    post {
                        always {
                            echo 'Publishing PMD results...'
                            // Archive PMD artifacts
                            archiveArtifacts artifacts: 'target/pmd/**/*', allowEmptyArchive: true
                            echo 'PMD report available at: target/pmd/pmd.html'
                        }
                    }
                }
            }
        }

        stage('Quality Gate - Coverage Check') {
            steps {
                echo 'Checking Quality Gate: 99% coverage required...'
                script {
                    // Wait for JaCoCo report to be generated
                    sleep(time: 2, unit: 'SECONDS')
                    
                    // Read JaCoCo XML report
                    def jacocoReportFile = 'target/site/jacoco/jacoco.xml'
                    if (!fileExists(jacocoReportFile)) {
                        error("❌ JaCoCo report not found at ${jacocoReportFile}. Please check if tests ran successfully.")
                    }
                    
                    def jacocoReport = readFile(jacocoReportFile)
                    def parser = new XmlSlurper().parseText(jacocoReport)
                    
                    // Calculate coverage from JaCoCo XML - use BUNDLE level
                    def report = parser.report
                    def counter = report.counter.find { 
                        it.@type == 'LINE'
                    }
                    
                    if (counter == null) {
                        // Try alternative path
                        counter = parser.counter.find { 
                            it.@type == 'LINE'
                        }
                    }
                    
                    if (counter == null) {
                        error("❌ Could not find LINE counter in JaCoCo report")
                    }
                    
                    def missed = (counter.@missed.text().toInteger())
                    def covered = (counter.@covered.text().toInteger())
                    def total = missed + covered
                    
                    def coverage = total > 0 ? (covered / total * 100) : 0
                    
                    echo "========================================="
                    echo "QUALITY GATE - COVERAGE REPORT"
                    echo "========================================="
                    echo "Lines Covered: ${covered}"
                    echo "Lines Missed: ${missed}"
                    echo "Total Lines: ${total}"
                    echo "Coverage: ${String.format("%.2f", coverage)}%"
                    echo "Required: 99.00%"
                    echo "========================================="
                    
                    // Set environment variable for other pipelines
                    env.COVERAGE_PERCENTAGE = String.format("%.2f", coverage)
                    env.COVERAGE_COVERED = "${covered}"
                    env.COVERAGE_MISSED = "${missed}"
                    env.COVERAGE_TOTAL = "${total}"
                    
                    if (coverage < 99.0) {
                        currentBuild.result = 'UNSTABLE'
                        error("❌ QUALITY GATE FAILED: Coverage ${String.format("%.2f", coverage)}% is below required 99.00%")
                    } else {
                        echo "✅ QUALITY GATE PASSED: Coverage ${String.format("%.2f", coverage)}% >= 99.00%"
                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Post-Build: Archiving artifacts and reports...'
            
            // Archive JAR
            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true, allowEmptyArchive: true
            
            // Archive JaCoCo reports
            archiveArtifacts artifacts: 'target/site/jacoco/**/*', allowEmptyArchive: true
            
            // Archive JUnit reports
            archiveArtifacts artifacts: 'target/surefire-reports/**/*', allowEmptyArchive: true
            
            // Archive PMD reports
            archiveArtifacts artifacts: 'target/pmd/**/*', allowEmptyArchive: true
            
            // Archive all site reports
            archiveArtifacts artifacts: 'target/site/**/*', allowEmptyArchive: true
            
            // Publish summary
            script {
                echo "========================================="
                echo "POST-BUILD SUMMARY"
                echo "========================================="
                echo "Coverage: ${env.COVERAGE_PERCENTAGE ?: 'N/A'}%"
                echo "Lines Covered: ${env.COVERAGE_COVERED ?: 'N/A'}"
                echo "Lines Missed: ${env.COVERAGE_MISSED ?: 'N/A'}"
                echo "Total Lines: ${env.COVERAGE_TOTAL ?: 'N/A'}"
                echo "========================================="
            }
        }
        success {
            echo '✅ Pipeline-test-dev completed successfully!'
            echo "Coverage: ${env.COVERAGE_PERCENTAGE}%"
            script {
                if (env.COVERAGE_PERCENTAGE != null && (env.COVERAGE_PERCENTAGE as Double) >= 99.0) {
                    echo 'Triggering Docker image build pipeline...'
                    build job: 'subscription-service-image-docker', wait: false, parameters: [
                        string(name: 'COVERAGE_PERCENTAGE', value: env.COVERAGE_PERCENTAGE),
                        string(name: 'BUILD_NUMBER', value: env.BUILD_NUMBER)
                    ]
                }
            }
        }
        failure {
            echo '❌ Pipeline-test-dev failed!'
        }
        unstable {
            echo '⚠️ Pipeline-test-dev unstable (Quality Gate failed)!'
        }
    }
}

