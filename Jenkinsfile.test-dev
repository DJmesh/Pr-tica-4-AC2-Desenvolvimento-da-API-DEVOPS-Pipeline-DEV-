pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    environment {
        // Valores padrão (podem ser sobrescritos pelo .env)
        DOCKERHUB_USER    = 'djmesh'
        DOCKER_IMAGE_NAME = 'subscription-service'
        MIN_COVERAGE      = '99.0'
        COVERAGE_PERCENTAGE = '0.0'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '========================================'
                echo 'PIPELINE DEV / TEST'
                echo '========================================'
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Load .env') {
            steps {
                script {
                    if (fileExists('.env')) {
                        echo 'Carregando variáveis do arquivo .env...'
                        def props = readProperties file: '.env'
                        props.each { k, v ->
                            echo "Set env: ${k}=${v}"
                            env[k] = v
                        }
                    } else {
                        echo 'Arquivo .env não encontrado, usando valores padrão do Jenkinsfile.'
                    }
                }
            }
        }

        stage('Build + Test (Maven)') {
            steps {
                echo 'Rodando mvn clean verify (tests + Jacoco + PMD)...'
                sh 'mvn clean verify'
            }
            post {
                always {
                    echo 'Arquivando relatórios de teste...'
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'

                    echo 'Arquivando relatório Jacoco (se existir)...'
                    // Só arquiva se o plugin Jacoco estiver configurado no Jenkins
                    // senão isso aqui é ignorado sem quebrar o build
                    jacoco execPattern: 'target/jacoco.exec', 
                           classPattern: 'target/classes', 
                           sourcePattern: 'src/main/java', 
                           inclusionPattern: '**/*.class', 
                           exclusionPattern: ''

                    echo 'Arquivando PMD (se existir)...'
                    recordIssues enabledForFailure: true, tool: pmdParser(pattern: 'target/pmd.xml')
                }
            }
        }

        stage('Calcular Cobertura Jacoco') {
            steps {
                script {
                    def jacocoFile = 'target/site/jacoco/jacoco.xml'
                    if (!fileExists(jacocoFile)) {
                        error "Arquivo ${jacocoFile} não encontrado. Verifique a configuração do Jacoco no pom.xml."
                    }

                    echo "Lendo cobertura do arquivo ${jacocoFile}..."

                    def xml = new XmlSlurper().parse(jacocoFile)
                    def lineCounter = xml.counter.find { it.@type == 'LINE' }

                    if (!lineCounter) {
                        error "Não foi possível encontrar o counter de LINE no Jacoco XML."
                    }

                    def covered = lineCounter.@covered.toInteger()
                    def missed  = lineCounter.@missed.toInteger()
                    def total   = covered + missed
                    def coverage = total > 0 ? (covered * 100.0 / total) : 0.0

                    def coverageStr = String.format(java.util.Locale.US, '%.2f', coverage)
                    env.COVERAGE_PERCENTAGE = coverageStr

                    echo "========================================="
                    echo "JACOCO COVERAGE"
                    echo "Lines covered : ${covered}"
                    echo "Lines missed  : ${missed}"
                    echo "Total lines   : ${total}"
                    echo "Coverage      : ${coverageStr}%"
                    echo "Meta (MIN_COVERAGE): ${env.MIN_COVERAGE}%"
                    echo "========================================="
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    double coverageValue = env.COVERAGE_PERCENTAGE.toDouble()
                    double minCoverage   = env.MIN_COVERAGE.toDouble()

                    if (coverageValue < minCoverage) {
                        error "❌ Quality Gate reprovado: cobertura ${coverageValue}% < ${minCoverage}%"
                    } else {
                        echo "✅ Quality Gate aprovado: cobertura ${coverageValue}% >= ${minCoverage}%"
                    }
                }
            }
        }

        stage('Disparar Pipeline de Imagem (Image_Docker)') {
            steps {
                script {
                    echo "Disparando pipeline Image_Docker com cobertura ${env.COVERAGE_PERCENTAGE}%..."
                    build job: 'Image_Docker', 
                        wait: false,
                        parameters: [
                            string(name: 'COVERAGE_PERCENTAGE', value: env.COVERAGE_PERCENTAGE),
                            string(name: 'BUILD_NUMBER',       value: env.BUILD_NUMBER ?: '')
                        ]
                }
            }
        }
    }

    post {
        always {
            echo '========================================'
            echo 'PIPELINE DEV / TEST FINALIZADO'
            echo 'Coverage calculada: ' + env.COVERAGE_PERCENTAGE + '%'
            echo '========================================'
        }
        success {
            echo '✅ Pipeline DEV/Test executado com sucesso.'
        }
        failure {
            echo '❌ Pipeline DEV/Test falhou. Verifique os logs e os relatórios.'
        }
    }
}
