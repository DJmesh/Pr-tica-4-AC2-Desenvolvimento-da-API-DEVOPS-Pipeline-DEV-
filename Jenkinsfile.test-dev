pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk   'JDK17'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '========================================'
                echo 'PIPELINE TEST-DEV'
                echo '========================================'
                checkout scm
            }
        }

        stage('Pre-Build') {
            steps {
                echo 'Limpando projeto (mvn clean)...'
                sh 'mvn clean'
            }
        }

        stage('Build, Test & Coverage') {
            steps {
                echo 'Executando mvn verify (testes + Jacoco + PMD)...'
                sh 'mvn verify'
            }
        }

        stage('Publicar Relatórios JUnit') {
            steps {
                echo 'Publicando relatórios JUnit...'
                junit testResults: 'target/surefire-reports/*.xml',
                      allowEmptyResults: true
            }
        }

        stage('Publicar Relatórios JaCoCo e PMD') {
            steps {
                echo 'Publicando relatórios HTML (JaCoCo e PMD)...'
                publishHTML([
                    reportDir: 'target/site/jacoco',
                    reportFiles: 'index.html',
                    reportName: 'JaCoCo Coverage Report',
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true
                ])

                publishHTML([
                    reportDir: 'target/site',
                    reportFiles: 'pmd.html',
                    reportName: 'PMD Report',
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true
                ])
            }
        }

        stage('Quality Gate (Jacoco >= 99%)') {
            steps {
                echo '''
                Se o mvn verify chegou até aqui, significa que:
                - Todos os testes passaram
                - A regra do Jacoco (coverage >= 99%) foi atendida
                Caso contrário, o build teria falhado na stage anterior.
                '''
            }
        }

        stage('Trigger Docker Image Pipeline') {
            steps {
                echo 'Quality Gate aprovado. Disparando pipeline de imagem Docker...'
                build job: 'subscription-service-image-docker',
                      parameters: [
                        string(name: 'GIT_COMMIT', value: env.GIT_COMMIT ?: ''),
                        booleanParam(name: 'QUALITY_GATE_PASSED', value: true)
                      ],
                      wait: false
            }
        }
    }

    post {
        success {
            echo '✅ PIPELINE TEST-DEV FINALIZADA COM SUCESSO!'
        }
        failure {
            echo '❌ PIPELINE TEST-DEV FALHOU. Verifique logs de testes/Jacoco/PMD.'
        }
        always {
            echo 'Build concluída. Consulte os relatórios JUnit/JaCoCo/PMD na aba de relatórios.'
        }
    }
}
