pipeline {
    agent any

    tools {
        maven 'Maven'      // nome cadastrado em Manage Jenkins → Global Tool Configuration
        jdk   'JDK17'      // idem
    }

    environment {
        APP_NAME            = 'subscription-service'
        JACOCO_MIN_COVERAGE = '0.99'   // usado no pom.xml (quality gate)
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Pre-Build') {
            steps {
                echo "Pre-Build: Cleaning workspace and preparing environment..."
                sh 'mvn --version'
                sh 'java -version'
                sh 'mvn clean'
            }
        }

        stage('Build') {
            steps {
                echo "Build: Compiling source code..."
                sh 'mvn compile -DskipTests'
            }
        }

        stage('Test') {
            steps {
                echo "Running all tests (JUnit)..."
                sh 'mvn test'
            }
            post {
                always {
                    echo 'Publicando resultados JUnit...'
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Code Quality Analysis') {
            parallel {

                stage('JaCoCo Coverage') {
                    steps {
                        echo "Generating JaCoCo code coverage report..."
                        // verify roda testes + jacoco:report + jacoco:check
                        sh 'mvn verify'
                    }
                    post {
                        always {
                            echo 'Publishing JaCoCo coverage report...'
                            publishHTML(target: [
                                reportName           : 'JaCoCo Coverage Report',
                                reportDir            : 'target/site/jacoco',
                                reportFiles          : 'index.html',
                                keepAll              : true,
                                alwaysLinkToLastBuild: true,
                                allowMissing         : true
                            ])
                        }
                    }
                }

                stage('PMD Analysis') {
                    steps {
                        echo "Running PMD static code analysis..."
                        sh 'mvn pmd:pmd pmd:check'
                    }
                    post {
                        always {
                            echo 'Publishing PMD results...'
                            // opção simples com HTML:
                            publishHTML(target: [
                                reportName           : 'PMD Report',
                                reportDir            : 'target/site',
                                reportFiles          : 'pmd.html',
                                keepAll              : true,
                                alwaysLinkToLastBuild: true,
                                allowMissing         : true
                            ])

                            // se tiver Warnings NG instalado, você pode adicionar:
                            // recordIssues enabledForFailure: true,
                            //              tools: [pmdParser(pattern: 'target/pmd/pmd.xml')]
                        }
                    }
                }
            }
        }

        stage('Quality Gate - Coverage >= 99%') {
            steps {
                script {
                    echo "Quality Gate: validando Jacoco >= 99% (configurado no pom.xml)"
                    // A validação real está no jacoco:check dentro do mvn verify
                    // Se cobertura < 99%, o mvn verify falha e o pipeline já teria quebrado
                }
            }
        }

        stage('Trigger Docker Image Pipeline') {
            steps {
                echo 'Quality Gate aprovado. Disparando pipeline de imagem Docker...'
                // Nome do outro job/pipeline que só constrói a imagem
                build job: 'subscription-service-image-docker',
                      parameters: [
                        string(name: 'GIT_COMMIT', value: env.GIT_COMMIT ?: '')
                      ],
                      wait: false
            }
        }
    }

    post {
        always {
            echo 'Post-Build: Archiving artifacts and reports...'
            archiveArtifacts artifacts: 'target/**/*.jar', fingerprint: true
        }
        success {
            echo '✅ Pipeline-test-dev SUCCESS!'
        }
        failure {
            echo '❌ Pipeline-test-dev failed!'
        }
    }
}
