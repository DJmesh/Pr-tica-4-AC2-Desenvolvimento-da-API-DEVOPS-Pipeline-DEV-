pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JDK17'
    }

    environment {
        JACOCO_COVERAGE = '0'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Pre-Build') {
            steps {
                echo 'Pre-Build: Cleaning workspace and preparing environment...'
                sh '''
                    echo Maven Version:
                    mvn --version

                    echo Java Version:
                    java -version

                    mvn clean
                '''
            }
        }

        stage('Build') {
            steps {
                echo 'Build: Compiling source code...'
                sh 'mvn compile -DskipTests'
            }
        }

        stage('Test') {
            steps {
                echo 'Running all tests (JUnit)...'
                sh 'mvn test'
            }
            post {
                always {
                    echo 'Publishing test results (JUnit)...'
                    // JUnit padrão do Jenkins – esse step EXISTE
                    junit allowEmptyResults: false,
                          testResults: 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Code Quality Analysis') {
            parallel {
                stage('JaCoCo Coverage') {
                    steps {
                        echo 'Generating JaCoCo coverage report...'
                        sh 'mvn -DskipTests=false test jacoco:report'
                        script {
                            def jacocoCsvPath = 'target/site/jacoco/jacoco.csv'
                            if (fileExists(jacocoCsvPath)) {
                                def csv = readFile(jacocoCsvPath)
                                def lines = csv.readLines()
                                if (lines.size() > 1) {
                                    def data = lines[1].split(',')
                                    // coluna 3 é a cobertura em %
                                    env.JACOCO_COVERAGE = data[3].trim()
                                    echo "JaCoCo Coverage (LINE): ${env.JACOCO_COVERAGE}%"
                                } else {
                                    echo 'JaCoCo CSV sem dados suficientes.'
                                }
                            } else {
                                echo "Arquivo ${jacocoCsvPath} não encontrado. Verifique a configuração do JaCoCo."
                            }
                        }
                    }
                }

                stage('PMD Analysis') {
                    steps {
                        echo 'Running PMD static code analysis...'
                        sh 'mvn pmd:pmd'
                    }
                }
            }
        }

        stage('Quality Gate - Coverage Check') {
            steps {
                script {
                    def coverage = env.JACOCO_COVERAGE?.trim()
                    if (!coverage) {
                        error "Não foi possível calcular a cobertura JaCoCo (JACOCO_COVERAGE vazio)."
                    }
                    def coverageVal = coverage.toBigDecimal()
                    echo "Quality Gate: coverage atual = ${coverageVal}%"

                    if (coverageVal < 99) {
                        currentBuild.result = 'UNSTABLE'
                        error "Quality Gate FAILED: cobertura abaixo de 99% (${coverageVal}%)."
                    } else {
                        echo "Quality Gate PASSED: cobertura >= 99% (${coverageVal}%)."
                    }
                }
            }
        }
    }

    post {
        always {
            echo '========================================='
            echo 'POST-BUILD SUMMARY (Pipeline-test-dev)'
            echo "Build: #${env.BUILD_NUMBER}"
            echo "Result: ${currentBuild.currentResult}"
            echo "JaCoCo Coverage (env): ${env.JACOCO_COVERAGE}%"
            echo '========================================='

            archiveArtifacts artifacts: 'target/**/*.*',
                             allowEmptyArchive: true
        }
        success {
            echo '✅ Pipeline-test-dev SUCCESS!'
        }
        unstable {
            echo '⚠️ Pipeline-test-dev unstable (Quality Gate failed)!'
        }
        failure {
            echo '❌ Pipeline-test-dev failed!'
        }
    }
}
