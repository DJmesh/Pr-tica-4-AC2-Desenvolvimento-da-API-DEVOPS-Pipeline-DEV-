pipeline {
    agent any

    stages {

        stage('Run Test Pipeline') {
            steps {
                echo '========================================'
                echo 'PIPELINE DEV - ORCHESTRAÇÃO'
                echo '========================================'
                echo 'Executando pipeline: subscription-service-test-dev...'
                // Se esse job falhar (teste ou Jacoco < 99%), esta stage falha e o restante não roda
                build job: 'subscription-service-test-dev',
                      wait: true,
                      propagate: true
            }
        }

        stage('Run Docker Image Pipeline') {
            steps {
                echo 'Disparando pipeline: subscription-service-image-docker...'
                build job: 'subscription-service-image-docker',
                      parameters: [
                        string(name: 'GIT_COMMIT', value: ''),
                        booleanParam(name: 'QUALITY_GATE_PASSED', value: true)
                      ],
                      wait: true,
                      propagate: true
            }
        }

        stage('Summary') {
            steps {
                echo '''
Pipeline DEV finalizada.

Sub-pipelines executados:
 - subscription-service-test-dev:
     * Pre-Build, Build, Test (JUnit + Cucumber)
     * Relatórios: JUnit, JaCoCo, PMD
     * Quality Gate Jacoco >= 99%
 - subscription-service-image-docker:
     * Build jar
     * (Simulação) build/test/push da imagem Docker

Os relatórios detalhados estão disponíveis nas builds dos sub-pipelines.
Use o navegador (Imprimir → Salvar como PDF) para gerar o documento solicitado na atividade.
'''
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline DEV SUCCESS!'
        }
        failure {
            echo '❌ Pipeline DEV failed. Check sub-pipeline logs.'
        }
    }
}
