pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JDK17'
    }

    environment {
        TEST_PIPELINE_JOB_NAME = 'subscription-service-test-dev'
        TEST_PIPELINE_BUILD_NUMBER = ''
        TEST_PIPELINE_RESULT = ''
    }

    stages {
        stage('Checkout') {
            steps {
                echo '========================================'
                echo 'PIPELINE DEV - MAIN'
                echo '========================================'
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Trigger Test Pipeline') {
            steps {
                script {
                    echo "Triggering sub-pipeline: ${env.TEST_PIPELINE_JOB_NAME}..."
                    def testBuild = build job: env.TEST_PIPELINE_JOB_NAME,
                                          propagate: false,
                                          wait: true

                    env.TEST_PIPELINE_BUILD_NUMBER = "${testBuild.number}"
                    env.TEST_PIPELINE_RESULT = "${testBuild.result}"

                    echo "Test Pipeline Build: #${env.TEST_PIPELINE_BUILD_NUMBER}"
                    echo "Result: ${env.TEST_PIPELINE_RESULT}"

                    if (testBuild.result != 'SUCCESS') {
                        error "Test pipeline failed with result: ${testBuild.result}"
                    }
                }
            }
        }

        stage('Quality Gate Validation') {
            steps {
                echo 'Validating Quality Gate from test pipeline...'
                script {
                    if (!env.TEST_PIPELINE_RESULT) {
                        error 'TEST_PIPELINE_RESULT não definido. Verifique a stage de Trigger Test Pipeline.'
                    }

                    if (env.TEST_PIPELINE_RESULT != 'SUCCESS') {
                        currentBuild.result = 'FAILURE'
                        error "Quality Gate DEV FAILED: test pipeline result = ${env.TEST_PIPELINE_RESULT}"
                    } else {
                        echo "Quality Gate DEV PASSED: test pipeline result = ${env.TEST_PIPELINE_RESULT}"
                    }
                }
            }
        }

        stage('Package Application') {
            steps {
                echo 'Packaging application (mvn package -DskipTests)...'
                sh 'mvn package -DskipTests'
                // Aqui depois você encaixa o pipeline de Docker/Image_Docker
                // ou o build da imagem no próprio Jenkinsfile.dev
            }
        }
    }

    post {
        always {
            echo '========================================'
            echo 'PIPELINE DEV COMPLETED'
            echo '========================================'
            echo "Test Pipeline Build: #${env.TEST_PIPELINE_BUILD_NUMBER}"
            echo "Result: ${env.TEST_PIPELINE_RESULT}"
            echo "Main Build Result: ${currentBuild.currentResult}"

            archiveArtifacts artifacts: 'target/**/*.*',
                             allowEmptyArchive: true

            // REMOVIDO: publishHTML (plugin não existe no Jenkins)
            // Se no futuro instalar o HTML Publisher, dá pra recolocar isso.
        }
        success {
            echo '✅ Pipeline DEV SUCCESS!'
        }
        failure {
            echo '❌ Pipeline DEV failed!'
        }
    }
}
